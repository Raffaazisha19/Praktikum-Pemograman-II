<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="300.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.module06.StudentController">

  <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
    <columns>
      <TableColumn fx:id="studentIdCol" text="NIM" />
      <TableColumn fx:id="nameCol" text="Nama" />
    </columns>
  </TableView>

</VBox>